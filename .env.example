# --- PostgreSQL / PostGIS ---
POSTGRES_DB=sara
POSTGRES_USER=sara
POSTGRES_PASSWORD=sara

# --- Host ports (dev convenience; internal networking unaffected) ---
API_PORT=8080
POSTGIS_PORT=5433
VALHALLA_PORT=8002
MARTIN_PORT=3000
REDIS_PORT=6379

# --- Engine URLs (internal network; used by the API gateway) ---
DATABASE_URL=postgresql://sara:sara@postgis:5432/sara
VALHALLA_URL=http://valhalla:8002
MARTIN_URL=http://martin:3000
REDIS_URL=redis://redis:6379

# --- Region / data pipeline ---
# City id used for file names
REGION_NAME=jabalpur
# SW lng,SW lat,NE lng,NE lat for osmium extraction
REGION_BBOX=79.82,22.95,80.25,23.36
# Source extract (Geofabrik India). One-time ~1.4 GB download.
INDIA_PBF_URL=https://download.geofabrik.de/asia/india-latest.osm.pbf
# Valhalla build threads
VALHALLA_THREADS=6

# --- API gateway ---
NODE_ENV=development
LOG_LEVEL=info
API_RATE_LIMIT_MAX=120
GEOCODE_CACHE_TTL_S=86400
ROUTE_CACHE_TTL_S=120
ISOCHRONE_CACHE_TTL_S=900
